# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for your environment.
# Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only - NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection, used only by the local SQL scripts
# (npm run db:apply / db:seed). Leave empty in production.
DATABASE_URL=

# Email notifications (any provider; see src/lib/notifications)
EMAIL_PROVIDER_API_KEY=
EMAIL_API_URL=
EMAIL_FROM="Srinivasula Seva Samstha <no-reply@example.com>"
CENTRAL_ADMIN_EMAIL=central-admin@yourdomain.com

# WhatsApp notifications (any provider; see src/lib/notifications)
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_SENDER_NUMBER=
CENTRAL_ADMIN_WHATSAPP=919999999999

# Without the provider keys above, notifications are logged on the server
# instead of being delivered.

# Public form anti-spam (optional Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Outgoing mail for ID cards (SMTP). The approval email carries the member's
# card as a PNG attachment. Without these, approvals still work but the card
# is not emailed — download it from the member's record instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Srinivasula Seva Samstha <no-reply@srinivasulasevasamstha.com>"

# Public contact form (FormSubmit - no account or API key needed).
# The address that receives enquiries from /about#contact.
NEXT_PUBLIC_CONTACT_FORM_EMAIL=srinivasreddyvootkuri@srinivasulasevasamstha.com
